{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://policyflow.uk/schemas/entity.schema.json",
  "title": "PolicyFlow Entity",
  "type": "object",
  "additionalProperties": false,
  "required": ["entity_id", "entity_type", "name"],
  "properties": {
    "entity_id": {"type": "string", "minLength": 1},
    "entity_type": {
      "type": "string",
      "enum": [
        "institution", "organisation", "company", "sector", "regulated_activity",
        "financial_product", "legal_instrument", "policy_topic"
      ]
    },
    "name": {"type": "string", "minLength": 1},
    "aliases": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true,
      "default": []
    },
    "identifiers": {
      "type": "object",
      "additionalProperties": {"type": "string"},
      "default": {}
    },
    "canonical_url": {"type": ["string", "null"], "format": "uri"},
    "valid_from": {"type": ["string", "null"], "format": "date-time"},
    "valid_to": {"type": ["string", "null"], "format": "date-time"},
    "notes": {"type": ["string", "null"]}
  }
}
