{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://policyflow.uk/schemas/relationship.schema.json",
  "title": "PolicyFlow Relationship",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "relationship_id", "subject_id", "predicate", "object_id",
    "status", "assertion_kind", "evidence_refs"
  ],
  "properties": {
    "relationship_id": {"type": "string", "minLength": 1},
    "subject_id": {"type": "string", "minLength": 1},
    "predicate": {
      "type": "string",
      "enum": [
        "AMENDS", "REPEALS", "COMMENCES", "MADE_UNDER", "AUTHORISED_BY",
        "IMPLEMENTS", "RESPONDS_TO", "CONSULTS_ON", "SUPERSEDES", "REFERENCES",
        "DEFINES", "APPLIES_TO", "AFFECTS", "REQUIRES", "PROHIBITS", "PERMITS", "EXEMPTS"
      ]
    },
    "object_id": {"type": "string", "minLength": 1},
    "status": {
      "type": "string",
      "enum": ["source_explicit", "human_confirmed", "machine_suggested"]
    },
    "assertion_kind": {
      "type": "string",
      "enum": ["SOURCE", "DERIVED", "MACHINE_EXTRACTED", "RESEARCHER", "HYPOTHESIS"]
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "valid_from": {"type": ["string", "null"], "format": "date-time"},
    "valid_to": {"type": ["string", "null"], "format": "date-time"},
    "derived_by": {"type": ["string", "null"]}
  }
}
